<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题 + 状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="继电器控制"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1D22" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未连接"
                android:textSize="14sp"
                android:textColor="#8A8F99" />
        </LinearLayout>

        <!-- 连接按钮 -->
        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="连接设备"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#185FA5" />

        <!-- 继电器状态 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_gravity="center_horizontal"
            android:text="继电器状态"
            android:textSize="13sp"
            android:textColor="#8A8F99" />

        <TextView
            android:id="@+id/tvRelay"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="12dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="未知"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#CCCCCC" />

        <!-- 开关按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="开"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0F6E56"
                android:enabled="false" />

            <Button
                android:id="@+id/btnOff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="关"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#C0392B"
                android:enabled="false" />
        </LinearLayout>

        <!-- 实时数据 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="实时数据（每 2 秒刷新）"
            android:textSize="13sp"
            android:textColor="#8A8F99" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFFFFF"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#B7791F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="温度（℃）"
                    android:textSize="12sp"
                    android:textColor="#8A8F99" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFFFFF"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvCur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#185FA5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="电流（mA）"
                    android:textSize="12sp"
                    android:textColor="#8A8F99" />
            </LinearLayout>
        </LinearLayout>

        <!-- 日志 -->
        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#101418"
            android:padding="12dp"
            android:text="日志\n"
            android:textColor="#C8D3DC"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>
</ScrollView>
